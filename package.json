{
  "name": "videobook-engine",
  "version": "3.0.0",
  "description": "Dolt-native local-first storage engine for Videobook",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fixtures/v5": "./fixtures/v5/contract-fixtures.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "fixtures"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic": "npm run build && tsx examples/basic-usage.ts",
    "examples": "npm run example:basic"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dolthub/doltlite": "^0.11.37",
    "@huggingface/transformers": "4.2.0",
    "node-gyp": "12.1.0",
    "sharp": "0.35.3",
    "usearch": "2.26.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.3",
    "knip": "^6.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "postcss": "^8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "@dolthub/doltlite@0.11.37": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "usearch@2.26.0": true
  }
}
