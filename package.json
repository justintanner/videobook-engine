{
  "name": "videobook-engine",
  "version": "1.0.0",
  "description": "Dolt-native local-first storage engine for Videobook",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic": "tsx examples/basic-usage.ts",
    "examples": "tsx examples/basic-usage.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dolthub/doltlite": "^0.11.37",
    "@huggingface/transformers": "4.2.0",
    "node-gyp": "12.1.0",
    "sharp": "0.35.3",
    "usearch": "2.26.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.3",
    "knip": "^6.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "^8.5.10",
    "sharp": "0.35.3"
  }
}
