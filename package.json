{
  "name": "clipfirst-fs",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:projects": "tsx examples/project-management.ts",
    "example:git": "tsx examples/git-history.ts",
    "examples": "tsx examples/basic-usage.ts && tsx examples/project-management.ts && tsx examples/git-history.ts",
    "bench": "vitest bench --config vitest.config.bench.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^4.5.3",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  }
}
