-  ExecScalar(env, "SELECT dolt_merge(?)", {branch});
+  // dolt_merge is a scalar function returning the resulting commit hash for a
+  // fast-forward or a three-way merge, and the text "Already up to date" when
+  // the incoming branch is an ancestor of HEAD (or the same commit).
+  std::string outcome = ExecScalar(env, "SELECT dolt_merge(?)", {branch});
   if (env.IsExceptionPending()) return env.Undefined();
-  // Derive fast_forward and conflicts from post-merge state.
+  // A fast-forward is the case where HEAD ends up on exactly the incoming
+  // branch head; a three-way merge lands on a new commit that is not the
+  // branch head, and an up-to-date merge returns no hash at all. Both values
+  // are read after the merge, so the outcome is never inferred from unlocked
+  // pre-merge state. A peer that advances the branch between the merge and
+  // this read makes the answer conservative (0), never falsely positive.
+  int fastForward = 0;
+  if (IsCommitHash(outcome)) {
+    std::string branchHead = ExecScalar(env, "SELECT dolt_hashof(?)", {branch});
+    if (env.IsExceptionPending()) return env.Undefined();
+    if (!branchHead.empty() && branchHead == outcome) fastForward = 1;
+  }
   std::string nConflicts = ExecScalar(env, "SELECT COUNT(*) FROM dolt_conflicts", {});
-  std::string logLen = ExecScalar(env,
-    "SELECT COUNT(*) FROM dolt_log LIMIT 2", {});
+  if (env.IsExceptionPending()) return env.Undefined();
   auto result = Napi::Object::New(env);
-  result.Set("fast_forward", Napi::Number::New(env, 0));
+  result.Set("fast_forward", Napi::Number::New(env, fastForward));
   result.Set("conflicts",    Napi::Number::New(env,
     (double)std::stoi(nConflicts.empty() ? "0" : nConflicts)));
   return result;
