@@ -94,6 +104,11 @@ Napi::Value Database::Open(const Napi::CallbackInfo& info) {
 }
 
 Napi::Value Database::Close(const Napi::CallbackInfo& info) {
+  // Like node:sqlite, finalise the connection's statements first. Otherwise
+  // sqlite3_close_v2 leaves a zombie connection that keeps the database files
+  // open until the garbage collector finalises the last statement, and on
+  // Windows those files cannot be deleted until then.
+  FinalizeStatements();
   if (db_) { sqlite3_close_v2(db_); db_ = nullptr; }
   path_.clear();
   return info.Env().Undefined();
