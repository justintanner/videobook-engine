     db.close()
     expect(() => db.prepare("SELECT 1")).toThrow()
   })
+
+  test("close() finalizes the connection's statements", () => {
+    const db: DatabaseSync = new DatabaseSync(":memory:")
+    db.exec("CREATE TABLE t (x INTEGER)")
+    const insert = db.prepare("INSERT INTO t VALUES (?)")
+    const select = db.prepare("SELECT x FROM t")
+    insert.run(1)
+    insert.run(2)
+    const rows = select.iterate()
+    expect(rows.next()).toEqual({ done: false, value: { x: 1 } })
+    db.close()
+    expect(() => insert.run(3)).toThrow("Statement is finalised")
+    expect(() => select.get()).toThrow("Statement is finalised")
+    expect(() => select.all()).toThrow("Statement is finalised")
+    expect(() => select.iterate()).toThrow("Statement is finalised")
+    expect(() => select.columns()).toThrow("Statement is finalised")
+    expect(() => rows.next()).toThrow("Statement is finalised")
+  })
+
+  test("close() releases the database files while statements are alive", () => {
+    const { path, cleanup } = tmpDb()
+    try {
+      const db: DatabaseSync = new DatabaseSync(path)
+      db.exec("CREATE TABLE t (x INTEGER)")
+      const insert = db.prepare("INSERT INTO t VALUES (?)")
+      insert.run(1)
+      const dir = dirname(path)
+      const before = openFilesUnder(dir)
+      if (before !== null) expect(before.length).toBeGreaterThan(0)
+      db.close()
+      const after = openFilesUnder(dir)
+      if (after !== null) expect(after).toEqual([])
+      // Windows refuses to delete a file that is still open.
+      rmSync(dir, { recursive: true })
+      expect(existsSync(dir)).toBe(false)
+      expect(() => insert.run(2)).toThrow("Statement is finalised")
+    } finally { cleanup() }
+  })
+
+  test("a reopened database prepares new statements", () => {
+    const { path, cleanup } = tmpDb()
+    try {
+      const db: DatabaseSync = new DatabaseSync(path)
+      db.exec("CREATE TABLE t (x INTEGER)")
+      const before = db.prepare("SELECT count(*) AS n FROM t")
+      db.close()
+      db.open(path)
+      db.exec("INSERT INTO t VALUES (1)")
+      expect(db.prepare("SELECT count(*) AS n FROM t").get()).toEqual({ n: 1 })
+      expect(() => before.get()).toThrow("Statement is finalised")
+      db.close()
+    } finally { cleanup() }
+  })
+
+  test("a statement keeps its database alive", () => {
+    const stmt = new DatabaseSync(":memory:").prepare("SELECT 1 AS x")
+    Bun.gc(true)
+    expect(stmt.get()).toEqual({ x: 1 })
+  })
 })
 
