 Database::~Database() {
+  // Each statement holds a reference to its DatabaseSync, so statements can
+  // only outlive it while the environment is torn down. Detach them so their
+  // destructors neither finalise twice nor touch this object.
+  for (Statement* stmt : statements_) stmt->Detach();
+  statements_.clear();
   if (db_) { sqlite3_close_v2(db_); db_ = nullptr; }
 }
 
+void Database::FinalizeStatements() {
+  for (Statement* stmt : statements_) stmt->Finalize();
+  statements_.clear();
+}
