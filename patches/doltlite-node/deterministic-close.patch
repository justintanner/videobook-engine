+
+/**
+ * Files under `dir` that this process still has open, or null where they
+ * cannot be listed: only Linux exposes its descriptors in /proc.
+ */
+export function openFilesUnder(dir: string): string[] | null {
+  if (process.platform !== "linux") return null
+  const open: string[] = []
+  for (const fd of readdirSync("/proc/self/fd")) {
+    try {
+      const target = readlinkSync(join("/proc/self/fd", fd))
+      if (target.startsWith(dir + "/")) open.push(target)
+    } catch {}
+  }
+  return open
+}
