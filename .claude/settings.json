{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "f=$(jq -r '.tool_input.file_path'); [[ \"$f\" == *.ts \u0026\u0026 \"$f\" != *\".claude/\"* ]] \u0026\u0026 npx prettier --write \"$f\" 2\u003e/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}